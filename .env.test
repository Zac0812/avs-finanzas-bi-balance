# Copia este archivo a ".env" y rellena los valores reales. ".env" nunca se sube a git.

# Ruta al JSON de la cuenta de servicio de Google (ver credenciales/credsDriveTest.json para el formato esperado)
GOOGLE_CREDENTIALS=credenciales/credsDrive.json

# Conexión a NetSuite vía Oracle ODBC (requiere "NetSuite Drivers 64bit" instalado)
ORACLE_USER=tu_usuario_netsuite
ORACLE_PASS=tu_password_netsuite
ORACLE_HOST=tu-cuenta.connect.api.netsuite.com
ORACLE_PORT=1708
ORACLE_ROLE_ID=1
ORACLE_ACCOUNT_ID=1234567

# Data warehouse destino (SQL Server, requiere "ODBC Driver 17 for SQL Server" instalado)
DW_SERVER=DW-GOMEX
DW_DB_Netsuite=RAW_NS
